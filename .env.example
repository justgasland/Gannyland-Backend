# Server-only values. Never prefix these with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# UUID of the single owner created through Supabase Auth. No automatic signup.
OWNER_USER_ID=
# Separate owner sender and API business number identity.
WHATSAPP_OWNER_PHONE=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Explicit supported Graph version, e.g. vNN.0 from your Meta app setup.
WHATSAPP_API_VERSION=
# Random secret for scheduled POST /api/internal/jobs
CRON_SECRET=
# Required only for natural-language draft interpretation.
OPENAI_API_KEY=
OPENAI_MODEL=
